# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/intellihire

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Optional: MongoDB Atlas Connection String Example
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/intellihire?retryWrites=true&w=majority

# ========== Multimodal Analysis Configuration ==========

# Hugging Face Space Settings (recommended for production)
# Set HF_SPACE_URL to use Hugging Face Space for audio/video analysis
# Leave empty or set USE_LOCAL_ANALYZER=true to use local Python analyzer
HF_SPACE_URL=https://huggingface.co/spaces/YOUR_USERNAME/intellihire-analyzer/api
# HF_SPACE_API_KEY is only needed for private Spaces
HF_SPACE_API_KEY=

# Local Python Analyzer Settings (fallback/development)
# Set to "true" to force using local Python analyzer instead of HF Space
USE_LOCAL_ANALYZER=false
# Python executable path (optional, defaults to python/python3 based on OS)
# PYTHON_EXECUTABLE=python3

# ========== LLM Configuration (Groq) ==========
# These should be already configured in your existing .env
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.1-8b-instant
